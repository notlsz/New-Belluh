{
  "headers": [
    { "source": "/.well-known/apple-app-site-association", "headers": [{ "key": "Content-Type", "value": "application/json" }] }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }
  ]
}
